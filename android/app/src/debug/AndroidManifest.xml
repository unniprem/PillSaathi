<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
      <!-- Debug-only adb hooks for driving the pill engine; see DebugAlarmReceiver. In :ringing,
           because DebugHooks and RingingState are per-process. -->
      <receiver
        android:name="com.pillsaathi.alarm.debug.DebugAlarmReceiver"
        android:process=":ringing"
        android:directBootAware="true"
        android:exported="true">
        <intent-filter>
            <action android:name="com.pillsaathi.DEBUG_ADD_PILL" />
            <action android:name="com.pillsaathi.DEBUG_LIST" />
            <action android:name="com.pillsaathi.DEBUG_TAKEN" />
            <action android:name="com.pillsaathi.DEBUG_SKIP" />
            <action android:name="com.pillsaathi.DEBUG_SNOOZE" />
            <action android:name="com.pillsaathi.DEBUG_AUTO_SILENCE_MS" />
            <action android:name="com.pillsaathi.DEBUG_STOP_SERVICE" />
            <action android:name="com.pillsaathi.DEBUG_SETTINGS" />
            <action android:name="com.pillsaathi.DEBUG_ADD_DOSE" />
        </intent-filter>
      </receiver>
      <!-- Debug-only adb hooks for Family; see DebugFamilyReceiver. Main process, where Firebase runs. -->
      <receiver
        android:name="com.pillsaathi.family.debug.DebugFamilyReceiver"
        android:exported="true">
        <intent-filter>
            <action android:name="com.pillsaathi.DEBUG_FAMILY_UPLOAD" />
            <action android:name="com.pillsaathi.DEBUG_FAMILY_LIST" />
        </intent-filter>
      </receiver>
    </application>
</manifest>
