<?xml version="1.0" encoding="utf-8"?>
<!-- Nunito at the four weights the app uses; registered as "Nunito" in MainApplication. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <font android:fontStyle="normal" android:fontWeight="600" android:font="@font/nunito_semibold"
        app:fontStyle="normal" app:fontWeight="600" app:font="@font/nunito_semibold" />
    <font android:fontStyle="normal" android:fontWeight="700" android:font="@font/nunito_bold"
        app:fontStyle="normal" app:fontWeight="700" app:font="@font/nunito_bold" />
    <font android:fontStyle="normal" android:fontWeight="800" android:font="@font/nunito_extrabold"
        app:fontStyle="normal" app:fontWeight="800" app:font="@font/nunito_extrabold" />
    <font android:fontStyle="normal" android:fontWeight="900" android:font="@font/nunito_black"
        app:fontStyle="normal" app:fontWeight="900" app:font="@font/nunito_black" />
</font-family>
