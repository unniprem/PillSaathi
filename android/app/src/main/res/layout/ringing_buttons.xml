<?xml version="1.0" encoding="utf-8"?>
<!-- The ringing screen's three buttons (activity_ringing, both ways up), in sp so they grow with the
     phone's text size. Held at the bottom of the space they are given. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="bottom"
    android:orientation="vertical">

    <Button
        android:id="@+id/ringing_taken"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/ringing_take_bg"
        android:backgroundTint="@null"
        android:elevation="10dp"
        android:minHeight="72dp"
        android:outlineAmbientShadowColor="#2E9E5B"
        android:outlineSpotShadowColor="#2E9E5B"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:stateListAnimator="@null"
        android:text="@string/action_taken"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="21sp"
        tools:targetApi="p" />

    <Button
        android:id="@+id/ringing_snooze"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/ringing_snooze_bg"
        android:backgroundTint="@null"
        android:minHeight="58dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:stateListAnimator="@null"
        android:text="@string/action_snooze"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="17sp" />

    <TextView
        android:id="@+id/ringing_skip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="2dp"
        android:background="?android:attr/selectableItemBackground"
        android:gravity="center"
        android:padding="15dp"
        android:text="@string/action_skip"
        android:textColor="#CCFFFFFF"
        android:textSize="14.5sp" />
</LinearLayout>
