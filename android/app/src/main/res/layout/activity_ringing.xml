<?xml version="1.0" encoding="utf-8"?>
<!-- The time and title are in dp, so the phone's text size can't grow them; pill names, amounts
     and buttons are in sp and grow, and the list scrolls so Taken always stays on screen. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0B0F"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/ringing_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="24dp"
        android:textColor="#FFFFFF"
        android:textSize="72dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:gravity="center"
        android:text="@string/ringing_title"
        android:textColor="#B0B0B8"
        android:textSize="22dp" />

    <!-- The due pills, one row each; long lists scroll while the buttons stay put. A tapped photo
         shows full width over the list until tapped again. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        android:layout_weight="1">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/ringing_pills"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <ImageView
            android:id="@+id/ringing_photo_large"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#0B0B0F"
            android:scaleType="fitCenter"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/ringing_sound"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginVertical="16dp"
        android:gravity="center"
        android:textColor="#B0B0B8"
        android:textSize="18sp" />

    <Button
        android:id="@+id/ringing_taken"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="88dp"
        android:background="#2E7D32"
        android:text="@string/action_taken"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/ringing_snooze"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:minHeight="64dp"
        android:background="@drawable/ringing_snooze_bg"
        android:backgroundTint="@null"
        android:text="@string/action_snooze"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/ringing_skip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:background="?android:attr/selectableItemBackground"
        android:padding="16dp"
        android:text="@string/action_skip"
        android:textColor="#B0B0B8"
        android:textSize="18sp" />
</LinearLayout>
