<?xml version="1.0" encoding="utf-8"?>
<!-- The ringing screen held upright; layout-land has the same parts side by side. The time and title
     are in dp, so the phone's text size can't grow them; pill names, amounts and buttons are in sp
     and grow. The buttons are measured first and keep their full height at the bottom; the dose
     above them (ringing_dose: title, time, pills, sound) scrolls in what is left.
     The sky (set by the hour in RingingActivity) fills the screen behind the system bars, and
     everything else sits inside them. Fonts and icons are set in RingingActivity, which falls back
     to the phone's font if they can't be read. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ringing_sky"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ringing_sky_night"
    android:clipToPadding="false"
    android:fitsSystemWindows="true">

    <include layout="@layout/ringing_sky_marks" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingBottom="8dp">

        <include
            layout="@layout/ringing_dose"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Scrolls only if the buttons alone are taller than the screen (the largest text and
             display size on a small phone), so none of them is ever cut off. -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <include layout="@layout/ringing_buttons" />
        </ScrollView>
    </LinearLayout>
</FrameLayout>
